{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Home Assistant Configuration",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "ha_url": {
      "type": "string",
      "description": "Home Assistant URL, e.g. http://192.168.1.50:8123",
      "x-widget": "url-input",
      "default": "",
      "x-display": "hidden"
    },
    "ha_token": {
      "type": "string",
      "description": "Home Assistant Long-Lived Access Token.",
      "x-widget": "password-input",
      "default": "",
      "x-display": "hidden"
    },
    "verify_ssl": {
      "type": "boolean",
      "default": true,
      "description": "Verify HTTPS certificates when connecting to Home Assistant.",
      "x-display": "hidden"
    },
    "connection_setup": {
      "type": "string",
      "title": "Home Assistant Connection",
      "default": "",
      "x-widget": "ha-connection-setup",
      "description": "Step 1: enter the Home Assistant URL and Long-Lived Access Token here, validate the connection, then save configuration. Other settings remain locked until validation succeeds."
    },
    "entity_browser": {
      "type": "string",
      "title": "Home Assistant Entity Browser",
      "default": "",
      "x-widget": "ha-entity-browser",
      "description": "After entering the Home Assistant URL and token, search Home Assistant by friendly name, entity ID, domain, state, device class, or unit and add results to the plugin."
    },
    "display_duration": {
      "type": "number",
      "default": 20,
      "minimum": 1,
      "maximum": 300
    },
    "request_timeout": {
      "type": "number",
      "default": 8,
      "minimum": 1,
      "maximum": 60,
      "x-advanced": true
    },
    "show_entities": {
      "type": "boolean",
      "default": true
    },
    "show_calendars": {
      "type": "boolean",
      "default": true
    },
    "enable_realtime_events": {
      "type": "boolean",
      "default": true
    },
    "notification_priority": {
      "type": "boolean",
      "default": true,
      "description": "Use native LEDMatrix live-priority so priority notifications interrupt normal rotation immediately."
    },
    "live_priority": {
      "type": "boolean",
      "default": true,
      "description": "Legacy alias for notification_priority.",
      "x-display": "hidden"
    },
    "notification_duration": {
      "type": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 300
    },
    "notification_queue_size": {
      "type": "integer",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    "notification_cooldown": {
      "type": "number",
      "default": 15,
      "minimum": 0,
      "maximum": 3600
    },
    "max_calendar_events": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 100
    },
    "layout": {
      "type": "string",
      "enum": [
        "auto",
        "text"
      ],
      "default": "auto"
    },
    "show_heading": {
      "type": "boolean",
      "default": true
    },
    "title_font_size": {
      "type": "integer",
      "default": 11,
      "minimum": 6,
      "maximum": 18
    },
    "subtitle_font_size": {
      "type": "integer",
      "default": 7,
      "minimum": 5,
      "maximum": 14
    },
    "heading_font_size": {
      "type": "integer",
      "default": 6,
      "minimum": 5,
      "maximum": 12
    },
    "row_gap": {
      "type": "integer",
      "default": 1,
      "minimum": 0,
      "maximum": 5
    },
    "enable_scroll": {
      "type": "boolean",
      "default": true,
      "description": "Enable pixel-width-aware marquee scrolling globally."
    },
    "scroll_speed": {
      "type": "number",
      "default": 14,
      "minimum": 1,
      "maximum": 120,
      "description": "Default marquee speed in pixels per second.",
      "x-widget": "slider"
    },
    "scroll_pause": {
      "type": "number",
      "default": 1.25,
      "minimum": 0,
      "maximum": 10,
      "x-advanced": true
    },
    "scroll_gap": {
      "type": "integer",
      "default": 28,
      "minimum": 8,
      "maximum": 256,
      "x-advanced": true
    },
    "scroll_trigger_ratio": {
      "type": "number",
      "default": 0.85,
      "minimum": 0.4,
      "maximum": 1,
      "x-advanced": true
    },
    "entity_heading_color": {
      "type": "array",
      "title": "Entity Heading Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        120,
        220,
        130
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "entity_title_color": {
      "type": "array",
      "title": "Entity Main Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        255,
        255
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "entity_subtitle_color": {
      "type": "array",
      "title": "Entity Secondary Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        180,
        180,
        180
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "calendar_heading_color": {
      "type": "array",
      "title": "Calendar Heading Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        90,
        190,
        255
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "calendar_title_color": {
      "type": "array",
      "title": "Calendar Main Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        255,
        255
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "calendar_subtitle_color": {
      "type": "array",
      "title": "Calendar Secondary Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        180,
        180,
        180
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "notification_heading_color": {
      "type": "array",
      "title": "Notification Heading Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        90,
        70
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "notification_title_color": {
      "type": "array",
      "title": "Notification Main Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        255,
        255
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "notification_subtitle_color": {
      "type": "array",
      "title": "Notification Secondary Text Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        220,
        220,
        220
      ],
      "x-widget": "color-picker",
      "description": "Choose visually with the color picker."
    },
    "entities": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "title": "Home Assistant Entity",
            "description": "Entity ID. Use the Entity Browser above to search and add entities automatically."
          },
          "label": {
            "type": "string"
          },
          "attribute": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "title_template": {
            "type": "string",
            "default": "{label}"
          },
          "value_template": {
            "type": "string",
            "default": "{value}{unit}"
          },
          "subtitle_template": {
            "type": "string",
            "default": ""
          },
          "state_map": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "heading_color": {
            "type": "array",
            "title": "Heading Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              120,
              220,
              130
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "title_color": {
            "type": "array",
            "title": "Main Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              255,
              255,
              255
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "subtitle_color": {
            "type": "array",
            "title": "Secondary Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              180,
              180,
              180
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "enable_scroll": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Override global scrolling for this item. Leave unset to inherit the global scrolling setting.",
            "default": null
          },
          "scroll_speed": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 120,
            "description": "Override marquee speed for this item in pixels per second.",
            "default": null
          },
          "scroll_pause": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "default": null
          },
          "scroll_gap": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 8,
            "maximum": 256,
            "default": null
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "x-widget": "array-table",
      "x-columns": [
        "entity_id",
        "label",
        "attribute",
        "unit"
      ],
      "maxItems": 50
    },
    "calendars": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "title": "Home Assistant Entity",
            "description": "Entity ID. Use the Entity Browser above to search and add entities automatically."
          },
          "label": {
            "type": "string",
            "default": "UPCOMING"
          },
          "days_ahead": {
            "type": "integer",
            "default": 7,
            "minimum": 1,
            "maximum": 365
          },
          "max_events": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 50
          },
          "heading_color": {
            "type": "array",
            "title": "Heading Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              90,
              190,
              255
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "title_color": {
            "type": "array",
            "title": "Main Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              255,
              255,
              255
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "subtitle_color": {
            "type": "array",
            "title": "Secondary Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              180,
              180,
              180
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "enable_scroll": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Override global scrolling for this item. Leave unset to inherit the global scrolling setting.",
            "default": null
          },
          "scroll_speed": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 120,
            "description": "Override marquee speed for this item in pixels per second.",
            "default": null
          },
          "scroll_pause": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "default": null
          },
          "scroll_gap": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 8,
            "maximum": 256,
            "default": null
          }
        },
        "required": [
          "entity_id"
        ],
        "additionalProperties": false
      },
      "x-widget": "array-table",
      "x-columns": [
        "entity_id",
        "label",
        "days_ahead",
        "max_events"
      ],
      "maxItems": 50
    },
    "event_notifications": {
      "type": "array",
      "default": [],
      "description": "State-change rules. entity_id supports wildcards such as binary_sensor.driveway_*.",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "title": "Home Assistant Entity",
            "description": "Entity ID. Use the Entity Browser above to search and add entities automatically."
          },
          "to": {
            "type": "string",
            "default": "",
            "title": "Trigger when state becomes",
            "description": "Optional comma-separated target state(s), for example on, detected, open. Leave blank for any new state."
          },
          "from": {
            "type": "string",
            "default": "",
            "title": "Trigger when previous state was",
            "description": "Optional comma-separated previous state(s). Leave blank for any previous state."
          },
          "attribute_equals": {
            "type": "object",
            "additionalProperties": true
          },
          "title": {
            "type": "string",
            "default": "HOME ALERT"
          },
          "message": {
            "type": "string",
            "default": "{friendly_name}: {state}"
          },
          "subtitle": {
            "type": "string",
            "default": ""
          },
          "priority": {
            "type": "boolean",
            "description": "When enabled, this alert uses LEDMatrix live priority and interrupts the current display immediately.",
            "default": true
          },
          "duration": {
            "type": "number",
            "minimum": 1,
            "maximum": 300
          },
          "cooldown": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600
          },
          "heading_color": {
            "type": "array",
            "title": "Heading Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              255,
              90,
              70
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "title_color": {
            "type": "array",
            "title": "Main Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              255,
              255,
              255
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "subtitle_color": {
            "type": "array",
            "title": "Secondary Text Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "default": [
              220,
              220,
              220
            ],
            "x-widget": "color-picker",
            "description": "Choose visually with the color picker."
          },
          "enable_scroll": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Override global scrolling for this item. Leave unset to inherit the global scrolling setting.",
            "default": null
          },
          "scroll_speed": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 120,
            "description": "Override marquee speed for this item in pixels per second.",
            "default": null
          },
          "scroll_pause": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "default": null
          },
          "scroll_gap": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 8,
            "maximum": 256,
            "default": null
          }
        },
        "required": [
          "entity_id",
          "message"
        ],
        "additionalProperties": false
      },
      "x-widget": "array-table",
      "x-columns": [
        "entity_id",
        "title",
        "message",
        "priority"
      ],
      "maxItems": 50
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}
